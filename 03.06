#include <iostream>
using namespace std;


// Завдання 1


int* createArray(int size)
{
    return new int[size];
}


void initArray(int* arr, int size)
{
    for (int i = 0; i < size; i++)
    {
        cout << "arr[" << i << "] = ";
        cin >> arr[i];
    }
}


void printArray(int* arr, int size)
{
    for (int i = 0; i < size; i++)
        cout << arr[i] << " ";

    cout << endl;
}


void deleteArray(int*& arr)
{
    delete[] arr;
    arr = nullptr;
}


void addElement(int*& arr, int& size, int value)
{
    int* temp = new int[size + 1];

    for (int i = 0; i < size; i++)
        temp[i] = arr[i];

    temp[size] = value;

    delete[] arr;
    arr = temp;
    size++;
}


void insertElement(int*& arr, int& size, int index, int value)
{
    int* temp = new int[size + 1];

    for (int i = 0; i < index; i++)
        temp[i] = arr[i];

    temp[index] = value;

    for (int i = index; i < size; i++)
        temp[i + 1] = arr[i];

    delete[] arr;
    arr = temp;
    size++;
}


void removeElement(int*& arr, int& size, int index)
{
    int* temp = new int[size - 1];

    for (int i = 0; i < index; i++)
        temp[i] = arr[i];

    for (int i = index + 1; i < size; i++)
        temp[i - 1] = arr[i];

    delete[] arr;
    arr = temp;
    size--;
}

// Завдання 2


bool isPrime(int n)
{
    if (n < 2)
        return false;

    for (int i = 2; i * i <= n; i++)
    {
        if (n % i == 0)
            return false;
    }

    return true;
}

int* removePrimes(int* arr, int size, int& newSize)
{
    newSize = 0;

    for (int i = 0; i < size; i++)
    {
        if (!isPrime(arr[i]))
            newSize++;
    }

    int* newArr = new int[newSize];

    int j = 0;
    for (int i = 0; i < size; i++)
    {
        if (!isPrime(arr[i]))
            newArr[j++] = arr[i];
    }

    return newArr;
}


// Завдання 3


void splitArray(int arr[], int size,
                int*& positive, int& posSize,
                int*& negative, int& negSize,
                int*& zero, int& zeroSize)
{
    posSize = negSize = zeroSize = 0;

    for (int i = 0; i < size; i++)
    {
        if (arr[i] > 0)
            posSize++;
        else if (arr[i] < 0)
            negSize++;
        else
            zeroSize++;
    }

    positive = new int[posSize];
    negative = new int[negSize];
    zero = new int[zeroSize];

    int p = 0, n = 0, z = 0;

    for (int i = 0; i < size; i++)
    {
        if (arr[i] > 0)
            positive[p++] = arr[i];
        else if (arr[i] < 0)
            negative[n++] = arr[i];
        else
            zero[z++] = arr[i];
    }
}





int main()
{
    // Завдання 1

    int size;
    cout << "Введіть розмір масиву: ";
    cin >> size;

    int* arr = createArray(size);

    initArray(arr, size);

    cout << "Початковий масив: ";
    printArray(arr, size);

    addElement(arr, size, 100);
    cout << "Після додавання 100 в кінець: ";
    printArray(arr, size);

    insertElement(arr, size, 1, 50);
    cout << "Після вставки 50 за індексом 1: ";
    printArray(arr, size);

    removeElement(arr, size, 2);
    cout << "Після видалення елемента з індексом 2: ";
    printArray(arr, size);


    // Завдання 2


    int newSize;
    int* newArr = removePrimes(arr, size, newSize);

    cout << "Масив без простих чисел: ";
    printArray(newArr, newSize);


    // Завдання 3


    int staticArr[] = {5, -3, 0, 8, -7, 2, 0, -1};
    int staticSize = sizeof(staticArr) / sizeof(staticArr[0]);

    int *positive, *negative, *zero;
    int posSize, negSize, zeroSize;

    splitArray(staticArr, staticSize,
               positive, posSize,
               negative, negSize,
               zero, zeroSize);

    cout << "Додатні: ";
    for (int i = 0; i < posSize; i++)
        cout << positive[i] << " ";

    cout << "\nВід'ємні: ";
    for (int i = 0; i < negSize; i++)
        cout << negative[i] << " ";

    cout << "\nНульові: ";
    for (int i = 0; i < zeroSize; i++)
        cout << zero[i] << " ";

    // Очищення пам'яті
    deleteArray(arr);
    delete[] newArr;
    delete[] positive;
    delete[] negative;
    delete[] zero;

    return 0;
}
