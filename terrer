#include <iostream>
using namespace std;

int main() {
    const int SIZE = 10;
    int marks[SIZE];
    int choice;

    // Введення оцінок
    cout << "Введіть 10 оцінок:\n";
    for (int i = 0; i < SIZE; i++) {
        cin >> marks[i];
    }

    do {
        cout << "\nМеню:\n";
        cout << "1 - Вивести оцінки\n";
        cout << "2 - Перескладання іспиту\n";
        cout << "3 - Чи є стипендія\n";
        cout << "0 - Вихід\n";
        cout << "Ваш вибір: ";
        cin >> choice;

        switch (choice) {

        case 1:
            cout << "Оцінки:\n";
            for (int i = 0; i < SIZE; i++) {
                cout << marks[i] << " ";
            }
            cout << endl;
            break;

        case 2: {
            int index, newMark;

            cout << "Введіть номер оцінки (1-10): ";
            cin >> index;

            if (index >= 1 && index <= 10) {
                cout << "Введіть нову оцінку: ";
                cin >> newMark;

                marks[index - 1] = newMark;
                cout << "Оцінку змінено.\n";
            }
            else {
                cout << "Невірний номер.\n";
            }

            break;
        }

        case 3: {
            double sum = 0;

            for (int i = 0; i < SIZE; i++) {
                sum += marks[i];
            }

            double avg = sum / SIZE;

            cout << "Середній бал: " << avg << endl;

            if (avg >= 10.7)
                cout << "Стипендія є.\n";
            else
                cout << "Стипендії немає.\n";

            break;
        }

        case 0:
            cout << "Програма завершена.\n";
            break;

        default:
            cout << "Невірний вибір.\n";
        }

    } while (choice != 0);

    return 0;
}
