#include <iostream>
using namespace std;
int number = 12; //глоб переменная

void printArray(int arr[] , int size) {
	for (int i=0; i<size; i++){
		cout << arr[i] << " ";
	}
	cout << '\n';
	//cout <<1;
}

void showGreeting() {
	cout << "Hello\n";
	//cout << size;
}
	
int increamentNumber(int num) {
	cout << &num <<'\n';
	return (++num);
}

double sum(double num1, double num2) {
	return num1 + num2;
}

void fillArrayRandom(int arr[], int size, int min, int max) {
	for (int i=0; i < size; i++){
		arr[i] = rand() % (max - min+1)+min; 
	}
}

int main()
{
	srand(time(NULL));

	const int size = 20;
	int arr[size] = { 10,34,56,2 };

	cout << arr << '\n';

	printArray(arr, size);
	fillArrayRandom(arr, size, -20, 20);
	printArray(arr, size);

	//cout << sizeof(sum) << '\n'; 
	int number = 10;

	cout << number << '\n'; 

	number = increamentNumber(number);

	increamentNumber(number);
	//{
	//	int number = 20; 
	//	cout << number << '\n'; //выведет 20, так как локальная переменная перекрывает глобальную
	//}
	cout << showGreeting << '\n';

	showGreeting();

	const int size = 5;
	int arr[size] = { 1,5,6,7,8 };

	printArray(arr, size);
}
