//num4

struct Car {
    char color[20];
    char model[20];
    char number[20];
};

void input(Car& c) {
    cin >> c.color;
    cin >> c.model;
    cin >> c.number;
}

void print(Car c) {
    cout << c.color << " "
        << c.model << " "
        << c.number << endl;
}

int main() {

    Car cars[10];

    for (int i = 0; i < 10; i++) {
        cout << "\nМашина " << i + 1 << ": ";
        input(cars[i]);
    }

    cout << "\nСписок машин:\n";

    for (int i = 0; i < 10; i++) {
        print(cars[i]);
    }

    return 0;
}
