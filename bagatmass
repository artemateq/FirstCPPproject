#include <iostream>

using namespace std;

int** createMatrix(int rows, int cols) {
    int** matrix = new int*[rows];
    for (int i = 0; i < rows; ++i) {
        matrix[i] = new int[cols];
    }
    return matrix;
}


void freeMatrix(int** matrix, int rows) {
    for (int i = 0; i < rows; ++i) {
        delete[] matrix[i];
    }
    delete[] matrix;
}


void printMatrix(int** matrix, int rows, int cols) {
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cout << matrix[i][j] << "\t";
        }
        cout << "\n";
    }
    cout << "\n";
}


void fillMatrix(int** matrix, int rows, int cols) {
    int val = 1;
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            matrix[i][j] = val++;
        }
    }
}



// Завдання 1

int** addColumn(int** matrix, int rows, int& cols, int pos, int* newCol) {
    if (pos < 0 || pos > cols) return matrix;

    int** newMatrix = createMatrix(rows, cols + 1);

    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols + 1; ++j) {
            if (j < pos) {
                newMatrix[i][j] = matrix[i][j];
            } else if (j == pos) {
                newMatrix[i][j] = newCol[i];
            } else {
                newMatrix[i][j] = matrix[i][j - 1];
            }
        }
    }

    freeMatrix(matrix, rows);
    cols++;
    return newMatrix;
}



// Завдання 2

int** deleteColumn(int** matrix, int rows, int& cols, int pos) {
    if (pos < 0 || pos >= cols || cols <= 0) return matrix;

    int** newMatrix = createMatrix(rows, cols - 1);

    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols - 1; ++j) {
            if (j < pos) {
                newMatrix[i][j] = matrix[i][j];
            } else {
                newMatrix[i][j] = matrix[i][j + 1];
            }
        }
    }

    freeMatrix(matrix, rows);
    cols--;
    return newMatrix;
}



// Завдання 3

void shiftMatrix(int** matrix, int rows, int cols, int count, int dir) {
    if (rows <= 0 || cols <= 0) return;

    count = count % ((dir == 1 || dir == 2) ? rows : cols);

    for (int k = 0; k < count; ++k) {
        if (dir == 1) { // Вгору
            int* temp = matrix[0];
            for (int i = 0; i < rows - 1; ++i) matrix[i] = matrix[i + 1];
            matrix[rows - 1] = temp;
        } 
        else if (dir == 2) { // Вниз
            int* temp = matrix[rows - 1];
            for (int i = rows - 1; i > 0; --i) matrix[i] = matrix[i - 1];
            matrix[0] = temp;
        } 
        else if (dir == 3) { // Вліво
            for (int i = 0; i < rows; ++i) {
                int temp = matrix[i][0];
                for (int j = 0; j < cols - 1; ++j) matrix[i][j] = matrix[i][j + 1];
                matrix[i][cols - 1] = temp;
            }
        } 
        else if (dir == 4) { // Вправо
            for (int i = 0; i < rows; ++i) {
                int temp = matrix[i][cols - 1];
                for (int j = cols - 1; j > 0; --j) matrix[i][j] = matrix[i][j - 1];
                matrix[i][0] = temp;
            }
        }
    }
}



// Завдання 4

int** transposeMatrix(int** matrix, int rows, int cols, int& newRows, int& newCols) {
    newRows = cols;
    newCols = rows;
    int** transposed = createMatrix(newRows, newCols);

    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            transposed[j][i] = matrix[i][j];
        }
    }
    return transposed;
}



