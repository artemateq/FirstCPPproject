int myStrcmp(const char* str1, const char* str2) {
    while (*str1 && (*str1 == *str2)) {
        str1++;
        str2++;
    }
    return *(unsigned char*)str1 - *(unsigned char*)str2;
}

void myStrcpy(char* dest, const char* src) {
    while ((*dest++ = *src++));
}

void searchByName(char*** phoneBook, int count, const char* name) {
    bool found = false;
    for (int i = 0; i < count; ++i) {
        if (myStrcmp(phoneBook[0][i], name) == 0) {
            cout << "Знайдено: " << phoneBook[0][i] << " - " << phoneBook[1][i] << "\n";
            found = true;
        }
    }
    if (!found) cout << "Запис не знайдено.\n";
}

void searchByPhone(char*** phoneBook, int count, const char* phone) {
    bool found = false;
    for (int i = 0; i < count; ++i) {
        if (myStrcmp(phoneBook[1][i], phone) == 0) {
            cout << "Знайдено: " << phoneBook[0][i] << " - " << phoneBook[1][i] << "\n";
            found = true;
        }
    }
    if (!found) cout << "Запис не знайдено.\n";
}

void editContact(char*** phoneBook, int count, int index, const char* newName, const char* newPhone) {
    if (index >= 0 && index < count) {
        myStrcpy(phoneBook[0][index], newName);
        myStrcpy(phoneBook[1][index], newPhone);
    }
}


