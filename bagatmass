bool contains(int* arr, int size, int val) {
    for (int i = 0; i < size; ++i) {
        if (arr[i] == val) return true;
    }
    return false;
}

bool inMatrix(int** mat, int r, int c, int val) {
    for (int i = 0; i < r; ++i) {
        for (int j = 0; j < c; ++j) {
            if (mat[i][j] == val) return true;
        }
    }
    return false;
}

void addUnique(int*& arr, int& size, int val) {
    if (!contains(arr, size, val)) {
        int* temp = new int[size + 1];
        for (int i = 0; i < size; ++i) temp[i] = arr[i];
        temp[size] = val;
        delete[] arr;
        arr = temp;
        size++;
    }
}

void printArray(const char* name, int* arr, int size) {
    cout << name << " [" << size << "]: ";
    for (int i = 0; i < size; ++i) cout << arr[i] << " ";
    cout << "\n";
}


