void sortSurnames(char surnames[5][50]) {
    for (int i = 0; i < 4; ++i) {
        for (int j = 0; j < 4 - i; ++j) {
            if (myStrcmp(surnames[j], surnames[j + 1]) > 0) {
                char temp[50];
                myStrcpy(temp, surnames[j]);
                myStrcpy(surnames[j], surnames[j + 1]);
                myStrcpy(surnames[j + 1], temp);
            }
        }
    }
}


