#include <iostream>

using namespace std;

void flip(int arr[], int i) {

    int start = 0;

    while(start < i) {

        swap(arr[start], arr[i]);

        start++;
        i--;
    }
}

int findMax(int arr[], int n) {

    int maxIndex = 0;

    for(int i = 1; i < n; i++) {

        if(arr[i] > arr[maxIndex]) {
            maxIndex = i;
        }
    }

    return maxIndex;
}

void pancakeSort(int arr[], int n) {

    for(int size = n; size > 1; size--) {

        int maxIndex = findMax(arr, size);

        if(maxIndex != size - 1) {

            flip(arr, maxIndex);

            flip(arr, size - 1);
        }
    }
}

int main() {

    int arr[] = {3, 6, 1, 9, 4, 2};
    int n = 6;

    pancakeSort(arr, n);

    cout << "Відсортовані оладки:\n";

    for(int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
