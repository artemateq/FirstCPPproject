#include <iostream>
using namespace std;

void sumArrays(int* A, int* B, int* C, int size) {

    for (int i = 0; i < size; i++) {
        *(C + i) = *(A + i) + *(B + i);
    }
}

int main() {

    const int SIZE = 5;

    int A[SIZE];
    int B[SIZE];
    int C[SIZE];

    cout << "Введіть елементи масиву 1:\n";
    for (int i = 0; i < SIZE; i++) {
        cin >> A[i];
    }

    cout << "\nВведіть елементи масиву 2:\n";
    for (int i = 0; i < SIZE; i++) {
        cin >> B[i];
    }

    sumArrays(A, B, C, SIZE);

    cout << "\nМасив 3:\n";

    for (int i = 0; i < SIZE; i++) {
        cout << C[i] << " ";
    }

    return 0;
}
