#include <iostream>
using namespace std;


// Завдання 1


int* mergeArrays(int* A, int M, int* B, int N)
{
    int* C = new int[M + N];

    for (int i = 0; i < M; i++)
        C[i] = A[i];

    for (int i = 0; i < N; i++)
        C[M + i] = B[i];

    return C;
}


// Завдання 2


bool contains(int* arr, int size, int value)
{
    for (int i = 0; i < size; i++)
    {
        if (arr[i] == value)
            return true;
    }
    return false;
}

int* commonElements(int* A, int M, int* B, int N, int& sizeC)
{
    int* temp = new int[(M < N) ? M : N];
    sizeC = 0;

    for (int i = 0; i < M; i++)
    {
        for (int j = 0; j < N; j++)
        {
            if (A[i] == B[j] && !contains(temp, sizeC, A[i]))
            {
                temp[sizeC++] = A[i];
            }
        }
    }

    int* C = new int[sizeC];

    for (int i = 0; i < sizeC; i++)
        C[i] = temp[i];

    delete[] temp;

    return C;
}


// Завдання 3


int* removeElements(int* A, int M, int choice, int& newSize)
{
    newSize = 0;

    for (int i = 0; i < M; i++)
    {
        if ((choice == 1 && A[i] % 2 != 0) ||
            (choice == 2 && A[i] % 2 == 0))
        {
            newSize++;
        }
    }

    int* B = new int[newSize];

    int j = 0;

    for (int i = 0; i < M; i++)
    {
        if ((choice == 1 && A[i] % 2 != 0) ||
            (choice == 2 && A[i] % 2 == 0))
        {
            B[j++] = A[i];
        }
    }

    return B;
}



int main()
{
   


    int M, N;

    cout << "Введіть розмір масиву A: ";
    cin >> M;

    int* A = new int[M];

    cout << "Введіть елементи масиву A:" << endl;
    for (int i = 0; i < M; i++)
        cin >> A[i];

    cout << "Введіть розмір масиву B: ";
    cin >> N;

    int* B = new int[N];

    cout << "Введіть елементи масиву B:" << endl;
    for (int i = 0; i < N; i++)
        cin >> B[i];

    int* C = mergeArrays(A, M, B, N);

    cout << "Третій масив:" << endl;
    for (int i = 0; i < M + N; i++)
        cout << C[i] << " ";

    cout << endl << endl;

    delete[] C;

   

    

    int sizeC;

    int* Common = commonElements(A, M, B, N, sizeC);

    cout << "Спільні елементи без повторень:" << endl;

    for (int i = 0; i < sizeC; i++)
        cout << Common[i] << " ";

    cout << endl << endl;

    delete[] Common;

    delete[] A;
    delete[] B;



   

    int size;

    cout << "Введіть розмір масиву: ";
    cin >> size;

    int* arr = new int[size];

    cout << "Введіть елементи масиву:" << endl;

    for (int i = 0; i < size; i++)
        cin >> arr[i];

    int choice;

    cout << "\n1 - Видалити парні числа" << endl;
    cout << "2 - Видалити непарні числа" << endl;
    cout << "Ваш вибір: ";
    cin >> choice;

    int newSize;

    int* result = removeElements(arr, size, choice, newSize);

    cout << "Новий масив:" << endl;

    for (int i = 0; i < newSize; i++)
        cout << result[i] << " ";

    cout << endl;

    delete[] arr;
    delete[] result;

    return 0;
}
