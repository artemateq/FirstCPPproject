#include <iostream>

using namespace std;

int main() {

    int arr[] = {5, 2, 8, 1, 9, 3};
    int size = 6;

    for(int i = 0; i < size - 1; i++) {

        int swaps = 0;

        for(int j = 0; j < size - i - 1; j++) {

            if(arr[j] > arr[j + 1]) {

                swap(arr[j], arr[j + 1]);
                swaps++;
            }
        }

        if(swaps == 0) {
            break;
        }
    }

    cout << "Відсортований масив:\n";

    for(int i = 0; i < size; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
